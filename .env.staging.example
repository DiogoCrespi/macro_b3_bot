# Copy to .env.staging locally. Do not commit the populated file.
APP_ENV=staging
LOG_LEVEL=INFO
DATA_DIR=/app/data
MIROFISH_ENABLED=true
MIROFISH_TIMEOUT_SECONDS=120
RESEARCH_MODE=true
ALLOW_BUY_SIGNALS=false
ALLOW_ORDER_EXECUTION=false
MIROFISH_IMAGE=mirofish-local@sha256:3ef16407aab37eb4933c12fa8f00f6447f4475ce05eb370ef4a12f49f964618e
STAGING_RUN_ID=replace-with-run-id
STAGING_COMMAND_JSON=["macro-b3","validate-config"]
